# DailyLingo Environment Variables
# The app is local-first: learning data stays in each browser.
#
# Accounts use Supabase Auth and are optional. Without these two values the
# app runs in guest mode and the account sheet explains that sign-up is not
# enabled on this build.
#
# Only the PUBLIC anon (publishable) key belongs here: Vite embeds every
# VITE_ value into the client bundle. Never put the service_role key or any
# other secret in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
